# ==============================================================================
# SMART RETAIL INVENTORY & DEMAND FORECASTING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- AWS Configuration ---
AWS_REGION=us-east-1
# Set DYNAMODB_ENDPOINT_URL for local development (e.g. http://localhost:8000 or http://dynamodb-local:8000 in Docker)
# Leave empty or omit when running against real AWS DynamoDB
DYNAMODB_ENDPOINT_URL=http://localhost:8000
# AWS credentials for local dev (can be dummy strings when using DynamoDB local)
AWS_ACCESS_KEY_ID=local_dev_key
AWS_SECRET_ACCESS_KEY=local_dev_secret

# --- DynamoDB Table Names ---
INVENTORY_TABLE_NAME=RetailInventory
SALES_TABLE_NAME=Sales
PREDICTIONS_TABLE_NAME=InventoryPredictions
ALERTS_TABLE_NAME=InventoryAlerts
WAREHOUSE_REQUESTS_TABLE_NAME=WarehouseRequests

# --- Amazon SNS Alerting ---
# Set to the ARN of the SNS topic created in AWS or mock SNS for local dev
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:smart-retail-inventory-alerts
ALERT_EMAIL_RECIPIENT=store-ops@example.com

# --- Machine Learning & Inventory Policies ---
MODEL_PATH=ml/artifacts/demand_model.joblib
MODEL_VERSION=1.0.0
STORE_IDS=STORE001,STORE002,STORE003
EXPIRY_WARNING_DAYS=7
DEMAND_FORECAST_DAYS=7
SAFETY_STOCK_FACTOR=1.2
EXCESS_STOCK_COVERAGE_DAYS=21

# --- Service Ports & URLs (Local Dev) ---
RETAIL_STORE_SERVICE_PORT=8001
INVENTORY_SERVICE_PORT=8002
WAREHOUSE_SERVICE_PORT=8003
FRONTEND_PORT=3000

RETAIL_STORE_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8002
WAREHOUSE_SERVICE_URL=http://localhost:8003

# --- Microsoft Entra ID Authentication ---
# In local development mode, AUTH_MODE can be set to "MOCK" to allow testing without Azure credentials.
# Set AUTH_MODE=ENTRA_ID for real Entra ID token verification.
AUTH_MODE=MOCK
AZURE_TENANT_ID=your-tenant-id-guid
AZURE_FRONTEND_CLIENT_ID=your-frontend-client-id-guid
AZURE_API_CLIENT_ID=api://your-backend-api-id-guid
AZURE_API_SCOPE=api://your-backend-api-id-guid/access_as_user

# --- Frontend Environment Variables (Prefix VITE_) ---
VITE_API_BASE_URL=http://localhost:8001
VITE_INVENTORY_API_BASE_URL=http://localhost:8002
VITE_WAREHOUSE_API_BASE_URL=http://localhost:8003
VITE_AUTH_MODE=MOCK
VITE_AZURE_TENANT_ID=your-tenant-id-guid
VITE_AZURE_CLIENT_ID=your-frontend-client-id-guid
VITE_AZURE_API_SCOPE=api://your-backend-api-id-guid/access_as_user
